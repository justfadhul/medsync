{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-drafts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sweep-break-glass",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/dispatch-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sweep-pre-arrivals",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/hmis-changes",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/pharmacy/sms/daily",
      "schedule": "0 5 * * *"
    }
  ]
}
