{
  "name": "medsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-founder-portraits.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "budget": "node scripts/check-budget.mjs",
    "start": "next start",
    "bench:build": "npm --prefix bionic-islet-bench install --no-audit --no-fund && npm --prefix bionic-islet-bench run build:embed",
    "bench:embed": "npm run bench:build && node scripts/embed-bench.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p supabase/functions/tsconfig.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:backfill-phone-hmac": "node --experimental-strip-types scripts/backfill-phone-hmac.ts",
    "lab:backfill-access": "node --experimental-strip-types scripts/lab/backfill-lab-access.ts",
    "lab:import-loinc": "node --experimental-strip-types scripts/lab/import-loinc.ts",
    "lab:trial": "node --experimental-strip-types scripts/lab/trial.ts",
    "pharmacy:catalogue-names": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/pharmacy/load-catalogue-names.ts",
    "pharmacy:import-catalogue": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/pharmacy/import-catalogue.ts",
    "pharmacy:seed-dev": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/pharmacy/seed-pharmacy-dev.ts",
    "pharmacy:seed-catalogue": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/pharmacy/seed-catalogue-from-emhslu.ts",
    "lab:migrate-offerings": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/lab/migrate-offerings.ts",
    "pharmacy:backfill-access": "node --experimental-strip-types scripts/pharmacy/backfill-pharmacy-access.ts",
    "db:seed-symptom-catalog": "tsx scripts/seed-symptom-catalog.ts",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emr-db": "EMR_PGLITE=1 vitest run tests/emr-db",
    "clerking:catalogue-check": "tsx scripts/clerking/catalogue-check.ts",
    "emr:legacy-counts": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/legacy-counts.ts",
    "emr:si-counts": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/si-counts.ts",
    "emr:backfill-allergies": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/backfill-allergies.ts",
    "emr:reencrypt-drafts": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/reencrypt-ncd-drafts.ts",
    "emr:encrypt-allergy-text": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/encrypt-backfilled-allergies.ts",
    "emr:backfill-relations": "NODE_PATH=node_modules/next/dist/compiled tsx --conditions=react-server scripts/emr/backfill-relations.ts",
    "ncd:manifest": "tsx scripts/ncd-manifest.ts",
    "ncd:check": "tsx scripts/ncd-check.ts",
    "prepare": "husky",
    "ncdreg:docs": "tsx scripts/ncdreg-docs.ts",
    "ncdreg:policies": "tsx scripts/ncdreg-policies.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vercel": "^54.3.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "@sentry/cli": true,
    "unrs-resolver": true,
    "fsevents": false
  }
}
