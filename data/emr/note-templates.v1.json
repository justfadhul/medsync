{
  "catalogue": "medsync.emr.note-templates",
  "version": "1.0.0",
  "status": "cso_signed",
  "signedBy": "Fadhul (owner, CSO)",
  "signedAt": "2026-09-26",
  "signature": "Signed as recommended in session (D-EMR-15: templates 2.1–2.10 and the minimum-to-sign table 2.11 of MS-EMR-CLIN-001); harmonisations marked [H] in docs/emr/HARMONISATION.md apply.",
  "source": "docs/emr/emr-clinical-reference.md sections 2.1–2.11",
  "rules": {
    "sectionOrder": "Fixed, as numbered. An empty optional section collapses to one line: '<title>  Not asked  Add'.",
    "triState": "Findings are present, absent or not asked; not asked leaves no fact (CFC C3).",
    "narrative": "Narrative is encrypted (lib/encryption.ts) and never read by engines.",
    "commit": "Chart actions commit at once as their own rows; note-born findings commit at signing in the same transaction (D-EMR-01).",
    "noCopyForward": "Narrative never carries forward; problems, allergies and medicines carry forward with a one-tap confirm.",
    "signingNeverBlocksCare": "Signing checks only minimumToSign.required; orders and prescriptions work on an unsigned draft (2.11). prompted items are warnings.",
    "checks": {
      "section_has_any": "the section holds at least one item of itemKinds",
      "section_has_content": "the section has narrative text or any structured item",
      "any_section_has_content": "at least one of sections has narrative text or any structured item",
      "field_present": "the named field of the section is filled",
      "item_true": "the item is confirmed true",
      "allergy_status_recorded": "the allergy record resolves to listed, no known drug allergies or unable to assess",
      "medicines_reconciled": "every current medication statement has a reconciliation this encounter"
    }
  },
  "references": {
    "REF-PREG-AGE": {
      "status": "pending_cso",
      "whilePending": "The obstetric and gynaecological module is offered collapsed ('Not asked · Add') for every patient whose sex at birth is female. The safety bar shows no pregnancy line and the imaging prompt does not fire until the range is signed."
    },
    "REF-IDSR-SCREEN": {
      "status": "pending_cso",
      "whilePending": "Exposure tokens are not offered; exposure history is narrative."
    }
  },
  "itemKinds": {
    "historian": "coded: patient | carer | relative | referral_letter (principle 6)",
    "language": "coded: language of the consultation",
    "interpreter": "name (encrypted) and relationship to the patient; optional",
    "complaint_token": "finding token (symptom_catalog code or finding concept) with a duration; becomes a finding fact at signing",
    "visit_reason": "coded review reason, reusing appointments.reason (follow_up, new_concern, refill, routine, urgent_review, other)",
    "finding": "finding token, tri-state present | absent | not asked, elicitedBy, qualifiers onset, duration, severity, laterality, course; not asked leaves no fact (CFC C3)",
    "exposure_token": "exposure finding from REF-IDSR-SCREEN (pending_cso: the picker shows no list until signed; narrative still works)",
    "ros_grid": "per-system grid of finding tokens (symptom_catalog ros_screen), every item defaulting to not asked",
    "problem_list": "condition, category problem_list_item: carry forward with a one-tap still-true confirm, or add; commits at once (D-EMR-01)",
    "procedure_history": "procedure fact (history), commits at once",
    "transfusion": "procedure fact proc.blood_transfusion with its effective date (an HbA1c validity modifier)",
    "medication_reconciliation": "medication statements confirmed continued | stopped (reason) | changed, incl. herbal, traditional and over-the-counter",
    "allergy_status": "the allergy record and its assertions (no known drug allergies, unable to assess); commits at once",
    "family_history": "condition with subject_relation (mother, father, sibling, child, other_first_degree, second_degree)",
    "social_history": "soc.tobacco, soc.alcohol, soc.physical_activity; occupation and living situation are narrative",
    "vital_signs": "observations shown from the record (projected, never copied); add if missing as new observation facts",
    "anthropometry": "obs.weight, obs.height, obs.waist, obs.muac",
    "exam_finding": "finding with elicitedBy examination: present | absent | not examined",
    "chaperone": "chaperone name and role for an intimate examination",
    "encounter_diagnosis": "condition, category encounter_diagnosis: working (provisional) | final (confirmed) | differential | refuted, one primary per visit",
    "diagnosis_deferred": "statement 'diagnosis deferred' with a reason",
    "order": "order (events lifecycle); commits at once; never blocked by an unsigned note",
    "prescription": "prescription (Phase 7, EMR_PRESCRIBING); commits at once",
    "procedure_plan": "planned or done procedure fact",
    "counselling": "procedure fact for counselling or education (e.g. proc.dsme_session, proc.nutrition_counselling)",
    "referral": "referral order (kind referral) and the referral note",
    "follow_up": "none | review date (scheduling intent) | as needed",
    "plan_statement": "a short plan statement when there is nothing to order",
    "resus_link": "link to the resus episode's ABCDE summary; read-only, never re-entered",
    "last_meal": "time of the last meal (glucose context: fasting hours derive from it)",
    "observation_series": "vital-sign series from observations, with times",
    "problems_addressed": "conditions addressed, each with its status",
    "tasks": "outstanding tasks, each with an owner, or 'none'",
    "team_present": "ward-round tag and the team present",
    "consent": "verbal | written, given by patient | guardian",
    "time_out": "two identifiers confirmed, procedure, site and side, allergies checked (WHO patient safety solution 4)",
    "operator": "operator and assistant (users)",
    "complications": "none, or described",
    "identify": "two identifiers and location, filled from the record",
    "receiver": "receiver name and an optional acknowledgement",
    "referral_fields": "HMIS 032-aligned fields (see template); field list confirmed against the current form (open confirmation)",
    "mccd_part1": "causal sequence (a) immediate cause back to the underlying cause, each a condition with an interval; ICD-11 coded",
    "mccd_part2": "other significant conditions",
    "manner_of_death": "coded per the current national form (open confirmation)",
    "certifier": "certifying clinician with cadre and council registration number",
    "care_given": "nursing care given",
    "addendum": "addendum text and reason",
    "pregnancy_module": "the 2.4 obstetric and gynaecological module",
    "paediatric_module": "the 2.3 paediatric module"
  },
