{
  "text": "<meta name=\"dash-one-writer\">\n<style>\n  .bp { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .bp-head { display: grid; gap: var(--cds-gap-sm); }\n  .bp-title { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); }\n  .bp-lede { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); }\n  .bp-lede b { color: var(--color-fg); font-variant-numeric: tabular-nums; }\n  .bp-sec { display: grid; gap: var(--cds-gap-md); }\n  .bp-sec h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .bp-sec > p { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .bp-wrap { overflow-x: auto; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-panel); }\n  .bp-table { width: 100%; min-width: 40rem; border-collapse: collapse; font-size: var(--cds-font-size-body); }\n  .bp-table th { text-align: left; white-space: nowrap; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-sm) var(--cds-pad-md); border-bottom: 1px solid var(--color-border-line); }\n  .bp-table td { vertical-align: top; padding: var(--cds-pad-sm) var(--cds-pad-md); border-bottom: 1px solid var(--color-border-line); }\n  .bp-table tbody tr:last-child td { border-bottom: 0; }\n  .bp-note { max-width: 28rem; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .bp-code { font-family: ui-monospace, Menlo, monospace; font-size: var(--cds-font-size-caption); white-space: nowrap; }\n  .bp-chip { display: inline-block; white-space: nowrap; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--color-border-line); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .bp-chip[data-s=\"Running\"] { color: var(--color-fg); border-color: var(--color-fg); }\n  .bp-chip[data-s=\"Done\"] { color: var(--color-ok); border-color: currentColor; }\n  .bp-chip[data-s=\"Needs you\"] { color: var(--color-warn); border-color: currentColor; }\n  .bp-chip[data-s=\"Blocked\"] { color: var(--color-bad); border-color: currentColor; }\n  .bp-bar { display: flex; align-items: center; gap: var(--cds-gap-sm); white-space: nowrap; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .bp-track { width: 5rem; height: 6px; border-radius: 3px; overflow: hidden; background: var(--cds-chart-grid); }\n  .bp-fill { height: 100%; }\n  [data-dash-source-state=refreshing] { opacity: .5; }\n</style>\n\n<div class=\"bp\">\n  <header class=\"bp-head\" id=\"summary\">\n    <h1 class=\"bp-title\">Booking pilot</h1>\n    <p class=\"bp-lede\"><b data-draw=\"done\" data-source=\"summary\" data-field=\"done\" data-row=\"0\">—</b> of <b data-draw=\"total\" data-source=\"summary\" data-field=\"total\" data-row=\"0\">—</b> tasks done. <b data-draw=\"running\" data-source=\"summary\" data-field=\"running\" data-row=\"0\">—</b> Claude sessions running, <b data-draw=\"waiting\" data-source=\"summary\" data-field=\"waiting\" data-row=\"0\">—</b> tasks waiting on you.</p>\n  </header>\n\n  <section class=\"bp-sec\" id=\"claude\">\n    <h2>Claude's sessions</h2>\n    <p>Each task runs in its own session and reports to the main chat, which updates this board.</p>\n    <div class=\"bp-wrap\">\n      <table class=\"bp-table\" id=\"claude-table\" data-source=\"tracks\" data-row-key=\"id\">\n        <thead><tr><th data-field=\"task\">Task</th><th data-field=\"status\">Status</th><th data-field=\"progress\">Progress</th><th data-field=\"branch\">Branch</th><th data-field=\"note\">Where it stands</th><th data-field=\"updated\">Updated</th></tr></thead>\n        <tbody data-draw=\"claude-rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"bp-sec\" id=\"owner\">\n    <h2>Your part</h2>\n    <p>Things only you can do. Tell the main chat when one changes.</p>\n    <div class=\"bp-wrap\">\n      <table class=\"bp-table\" id=\"owner-table\" data-source=\"tracks\" data-row-key=\"id\">\n        <thead><tr><th data-field=\"task\">Task</th><th data-field=\"status\">Status</th><th data-field=\"note\">Note</th></tr></thead>\n        <tbody data-draw=\"owner-rows\"></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\n  dash.calc('summary', {\n    inputs: ['tracks'],\n    title: 'Task counts',\n    description: 'How many tasks are done, how many sessions are running and how many tasks wait on the owner.',\n    fn: (tracks) => {\n      const count = (status) => tracks.filter((task) => task.status === status).length;\n      return [{ done: count('Done'), total: tracks.length, running: count('Running'), waiting: count('Needs you') }];\n    },\n  });\n\n  for (const field of ['done', 'total', 'running', 'waiting']) {\n    dash.draw(field, (el) => {\n      const s = dash.data('summary');\n      el.textContent = s.status === 'ok' && s.data && s.data[0] ? String(s.data[0][field]) : '—';\n    });\n  }\n\n  const parseDay = d3.utcParse('%Y-%m-%d');\n  const fmtDay = d3.utcFormat('%-d %b');\n\n  function rowsFor(area) {\n    const t = dash.data('tracks');\n    return t.status === 'ok' ? t.data.filter((r) => r.area === area) : [];\n  }\n  function td(tr, text, cls) {\n    const c = document.createElement('td');\n    if (cls) c.className = cls;\n    c.textContent = text == null || text === '' ? '—' : String(text);\n    tr.appendChild(c);\n    return c;\n  }\n  function chip(tr, status) {\n    const c = document.createElement('td');\n    const s = document.createElement('span');\n    s.className = 'bp-chip';\n    s.dataset.s = status;\n    s.textContent = status;\n    c.appendChild(s);\n    tr.appendChild(c);\n  }\n  function progress(tr, value) {\n    const c = document.createElement('td');\n    const pct = Math.max(0, Math.min(100, Number(value) || 0));\n    const bar = document.createElement('div');\n    bar.className = 'bp-bar';\n    const track = document.createElement('div');\n    track.className = 'bp-track';\n    const fill = document.createElement('div');\n    fill.className = 'bp-fill';\n    fill.style.width = pct + '%';\n    fill.style.background = dash.colors[0];\n    track.appendChild(fill);\n    const label = document.createElement('span');\n    label.textContent = String(pct);\n    bar.append(track, label, '%');\n    c.appendChild(bar);\n    tr.appendChild(c);\n  }\n  function row(r) {\n    const tr = document.createElement('tr');\n    tr.dataset.key = r.id;\n    return tr;\n  }\n\n  dash.draw('claude-rows', (tb) => {\n    tb.replaceChildren(\n      ...rowsFor('Claude').map((r) => {\n        const tr = row(r);\n        td(tr, r.task);\n        chip(tr, r.status);\n        progress(tr, r.progress);\n        td(tr, r.branch, 'bp-code');\n        td(tr, r.note, 'bp-note');\n        const day = r.updated ? parseDay(r.updated) : null;\n        td(tr, day ? fmtDay(day) : r.updated, 'bp-note');\n        return tr;\n      }),\n    );\n  });\n\n  dash.draw('owner-rows', (tb) => {\n    tb.replaceChildren(\n      ...rowsFor('You').map((r) => {\n        const tr = row(r);\n        td(tr, r.task);\n        chip(tr, r.status);\n        td(tr, r.note, 'bp-note');\n        return tr;\n      }),\n    );\n  });\n</script>\n",
  "edit": { "via": "claude", "at": "2026-11-12T10:34:00Z" }
}
